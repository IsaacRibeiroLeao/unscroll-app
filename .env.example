# Public (embedded in the app bundle). NEVER put secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Build-time only (read by app.config.ts, not embedded in the bundle)
APPLE_TEAM_ID=<10-char-apple-team-id>

# Gemini key lives ONLY in Supabase secrets:
#   supabase secrets set GEMINI_API_KEY=...
# RevenueCat public SDK keys (added in the paywall phase)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=<revenuecat-public-sdk-key-ios>
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=<revenuecat-public-sdk-key-android>
